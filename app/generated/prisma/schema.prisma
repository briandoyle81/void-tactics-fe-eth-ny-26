generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Users ──────────────────────────────────────────────────────────────────────

model User {
  id                  String    @id // Google OAuth sub (user.id from NextAuth)
  email               String    @unique
  username            String?
  creditBalance       Int       @default(0)
  // Drone Energy Cores — web2 counterpart to the on-chain DroneEnergyCores
  // ERC20 (docs/faction-2.md §2-3). Earned only from destroying AI-owned
  // ships (see gameEngineWeb2.ts's kill-reward branch), spent at the Drone
  // Storefront for a permanent droneCoreTier bump. Unlike web3, not a
  // separate transferable token — a plain per-user balance, since web2 has
  // no peer-to-peer transfer surface for any of its currencies today.
  decBalance          Int       @default(0)
  // Drone Storefront tier (docs/faction-2.md §3) — permanent, cumulative;
  // adds droneCoreTier extra ships to every free-ship claim
  // (see /api/ships/claim-free/route.ts).
  droneCoreTier       Int       @default(0)
  purchasedShipCount  Int       @default(0)
  lobbiesCreatedCount Int       @default(0) // total lobby creations; first freeGamesPerAddress are free
  kickCount           Int       @default(0) // cumulative times timed out/kicked from lobbies
  kickTimeoutUntil    DateTime? // locked out of creating/joining lobbies until this time
  tutorialCompleted   Boolean   @default(false)
  tutorialPath        String? // "win" | "loss" — which branch the player finished
  createdAt           DateTime  @default(now())

  ships                   Ship[]
  lobbiesCreated          Lobby[]                  @relation("LobbyCreator")
  lobbiesJoined           Lobby[]                  @relation("LobbyJoiner")
  lobbiesReserved         Lobby[]                  @relation("LobbyReservedJoiner")
  gamesAsPlayer1          Game[]                   @relation("GamePlayer1")
  gamesAsPlayer2          Game[]                   @relation("GamePlayer2")
  fleets                  Fleet[]
  stats                   PlayerStats?
  tournamentsCreated      Tournament[]             @relation("TournamentCreator")
  tournamentRegistrations TournamentRegistrant[]
  tournamentMatchesAsP1   TournamentMatch[]        @relation("TournamentMatchPlayer1")
  tournamentMatchesAsP2   TournamentMatch[]        @relation("TournamentMatchPlayer2")
  campaignNodeCompletions CampaignNodeCompletion[]
  roguelikeRuns           RoguelikeRun[]
}

// ── Ships ──────────────────────────────────────────────────────────────────────

model Ship {
  id             Int       @id @default(autoincrement())
  ownerId        String
  owner          User      @relation(fields: [ownerId], references: [id])
  name           String    @default("Ship")
  // equipment: { mainWeapon: 0-3, armor: 0-3, shields: 0-3, special: 0-3 }
  equipment      Json
  // traits: { serialNumber, colors: { h1,s1,l1,h2,s2,l2 }, variant, accuracy, hull, speed }
  traits         Json
  cost           Int       @default(0)
  costsVersion   Int       @default(0)
  isFree         Boolean   @default(false)
  modifiedCount  Int       @default(0)
  shiny          Boolean   @default(false)
  constructed    Boolean   @default(false)
  inFleet        Boolean   @default(false)
  destroyed      Boolean   @default(false)
  shipsDestroyed Int       @default(0)
  destroyedAt    DateTime?
  createdAt      DateTime  @default(now())

  roguelikeRosterEntries RoguelikeRosterShip[]

  @@index([ownerId])
  @@index([ownerId, destroyed])
  @@index([ownerId, createdAt])
}

// ── Fleets ─────────────────────────────────────────────────────────────────────
// One fleet per player per lobby. Query: fleet where lobbyId=X and ownerId=Y.

model Fleet {
  id                Int      @id @default(autoincrement())
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id])
  lobbyId           Int
  lobby             Lobby    @relation(fields: [lobbyId], references: [id])
  // Ship IDs in this fleet (references Ship.id)
  shipIds           Int[]
  totalCost         Int      @default(0)
  isComplete        Boolean  @default(false)
  // Starting grid positions: [{ row, col }] indexed to match shipIds
  startingPositions Json?
  createdAt         DateTime @default(now())

  @@index([lobbyId])
  @@index([lobbyId, ownerId])
}

// ── Lobbies ────────────────────────────────────────────────────────────────────

model Lobby {
  id               Int         @id @default(autoincrement())
  creatorId        String
  creator          User        @relation("LobbyCreator", fields: [creatorId], references: [id])
  joinerId         String?
  joiner           User?       @relation("LobbyJoiner", fields: [joinerId], references: [id])
  reservedJoinerId String? // pre-set joiner for private lobbies
  reservedJoiner   User?       @relation("LobbyReservedJoiner", fields: [reservedJoinerId], references: [id])
  mapId            Int?
  map              Map?        @relation(fields: [mapId], references: [id])
  status           LobbyStatus @default(OPEN)
  costLimit        Int         @default(0) // max total fleet cost
  turnTimeSeconds  Int         @default(120)
  maxScore         Int         @default(3)
  creatorGoesFirst Boolean?
  isAiGame         Boolean     @default(false)
  aiDifficulty     String? // "recruit" | "veteran" | "commander" | "elite"
  createdAt        DateTime    @default(now())
  joinedAt         DateTime?
  joinerFleetSetAt DateTime? // when joiner submitted their fleet (for quitWithPenalty check)

  campaignNodeId Int?
  campaignNode   CampaignNode? @relation(fields: [campaignNodeId], references: [id])
  roguelikeRunId Int?
  roguelikeRun   RoguelikeRun? @relation(fields: [roguelikeRunId], references: [id])

  fleets          Fleet[]
  game            Game?
  tournamentMatch TournamentMatch?

  @@index([creatorId])
  @@index([joinerId])
  @@index([status])
  @@index([reservedJoinerId])
  @@index([campaignNodeId])
  @@index([roguelikeRunId])
}

enum LobbyStatus {
  OPEN
  FLEET_SELECTION
  IN_GAME
  CANCELLED
  COMPLETED
}

// ── Games ──────────────────────────────────────────────────────────────────────

model Game {
  id           Int       @id @default(autoincrement())
  lobbyId      Int       @unique
  lobby        Lobby     @relation(fields: [lobbyId], references: [id])
  player1Id    String // creator
  player1      User      @relation("GamePlayer1", fields: [player1Id], references: [id])
  player2Id    String // joiner
  player2      User      @relation("GamePlayer2", fields: [player2Id], references: [id])
  // Full serialised GameDataView — served directly to the client
  state        Json
  initialState Json? // GameDataView at game start — used for replay
  currentTurn  String // userId of the player whose turn it is
  currentRound Int       @default(1)
  phase        GamePhase @default(ACTIVE)
  winnerId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  turns GameTurn[]

  @@index([player1Id])
  @@index([player2Id])
}

enum GamePhase {
  ACTIVE
  COMPLETED
  TIMED_OUT
  ABANDONED
}

model GameTurn {
  id          Int      @id @default(autoincrement())
  gameId      Int
  game        Game     @relation(fields: [gameId], references: [id])
  playerId    String
  round       Int
  // Array of actions submitted this turn: [{ type, shipId, targetRow, targetCol, ... }]
  actions     Json
  // Full GameDataView snapshot after this action — used for step-through replay
  snapshot    Json?
  submittedAt DateTime @default(now())

  @@index([gameId, round])
}

// ── Maps ───────────────────────────────────────────────────────────────────────

model Map {
  id           Int      @id @default(autoincrement())
  name         String
  gridWidth    Int      @default(17)
  gridHeight   Int      @default(11)
  // [{ row, col }]
  blockedTiles Json     @default("[]")
  // [{ row, col, points, onlyOnce }]
  scoringTiles Json     @default("[]")
  // 0=PvP, 1=PvE, 2=Both — mirrors web3's Maps.mapMode/MapMode enum. Defaults
  // to Both, same as Maps.tsx's createMode default (valid for every picker
  // until an admin narrows it deliberately).
  mode         Int      @default(2)
  createdAt    DateTime @default(now())

  lobbies        Lobby[]
  aiPlacements   AIMapPlacement[]
  campaignNodes  CampaignNode[]
  roguelikeNodes RoguelikeNode[]
}

// ── AI Encounters (web2 counterpart to the on-chain AIEncounters contract) ──────
// Admin-curated single-player AI content: ship loadouts (AIShipConfig) placed
// onto specific map tiles (AIMapPlacement). Mirrors AIEncounters.sol's
// aiShipConfigs/mapPlacements 1:1 in shape, gated the same way
// (requireWeb2Admin, not per-address on-chain permissions).

model AIShipConfig {
  id        Int      @id @default(autoincrement())
  name      String
  // ShipEquipment: { mainWeapon, armor, shields, special }
  equipment Json
  // ShipTraits: { serialNumber, colors: {h1,s1,l1,h2,s2,l2}, variant, accuracy, hull, speed }
  traits    Json
  // Archetype enum value: Grunt=0, Aggressor=1, Sniper=2, Support=3, Turtle=4, Rammer=5
  archetype Int
  createdAt DateTime @default(now())

  placements AIMapPlacement[]
}

model AIMapPlacement {
  id       Int          @id @default(autoincrement())
  mapId    Int
  map      Map          @relation(fields: [mapId], references: [id])
  row      Int
  col      Int
  configId Int
  config   AIShipConfig @relation(fields: [configId], references: [id])

  @@unique([mapId, row, col])
  @@index([mapId])
}

// Records which AIShipConfig (and therefore which archetype) a given
// generated AI Ship row was built from — Ship itself has no archetype
// field, and AI ships are freshly generated per game (see aiFleetWeb2.ts),
// so this is the only place that mapping is recoverable at take-turn time.
model AIFleetShip {
  shipId    Int @id
  configId  Int
  archetype Int
}

// ── Campaign (web2 counterpart to the on-chain NodeMap/SinglePlayerMatch) ───────
// Mirrors NodeMap's graph shape 1:1: nodes grouped into campaigns, ANY-of
// `prerequisites` unlock (computed at read time from CampaignNodeCompletion,
// not stored — matches NodeMap.isNodeUnlocked). `enemyThreat` is
// deliberately absent, same as the current on-chain shape — derive it from
// AIMapPlacement/AIShipConfig the same way the web3 CampaignNodePreview does
// (useMapEnemyThreat), not stored here either.

model Campaign {
  id              Int      @id @default(autoincrement())
  requiredVariant Int      @default(0) // 0 = unrestricted, matches NodeMap.campaignRequiredVariant
  createdAt       DateTime @default(now())

  nodes CampaignNode[]
}

model CampaignNode {
  id               Int      @id @default(autoincrement())
  campaignId       Int
  campaign         Campaign @relation(fields: [campaignId], references: [id])
  mapId            Int
  map              Map      @relation(fields: [mapId], references: [id])
  prerequisites    Int[] // CampaignNode ids; ANY-of unlock
  costLimit        Int
  turnTimeSeconds  Int
  maxScore         Int
  creatorGoesFirst Boolean  @default(true)
  createdAt        DateTime @default(now())

  completions CampaignNodeCompletion[]
  lobbies     Lobby[]

  @@index([campaignId])
}

model CampaignNodeCompletion {
  id          Int          @id @default(autoincrement())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  nodeId      Int
  node        CampaignNode @relation(fields: [nodeId], references: [id])
  completedAt DateTime     @default(now())

  @@unique([userId, nodeId])
  @@index([userId])
}

// ── Roguelike (web2 counterpart to RoguelikeNodeMap/RoguelikeRun/RoguelikeMatch/RoguelikeResupply) ──
// Run-based, persistent roster/HP, branching children-with-lockout graph —
// structurally distinct from the plain-prerequisites Campaign model above,
// matching how the two on-chain systems are also genuinely different data
// models (see RoguelikeGraph.tsx's doc-comment). One active run per player
// is app-enforced (status = ACTIVE, matches the contract's RunAlreadyActive
// revert); `generation` increments per new run for the same player so old
// runs stay distinguishable, matching the on-chain struct field.

model RoguelikeCampaign {
  id              Int      @id @default(autoincrement())
  requiredVariant Int      @default(0)
  autoHealPercent Int      @default(0)
  initialCostCap  Int
  rootNodeId      Int?
  createdAt       DateTime @default(now())

  nodes RoguelikeNode[]
  runs  RoguelikeRun[]
}

model RoguelikeNode {
  id               Int               @id @default(autoincrement())
  campaignId       Int
  campaign         RoguelikeCampaign @relation(fields: [campaignId], references: [id])
  kind             Int // Combat=0, Resupply=1
  mapId            Int?
  map              Map?              @relation(fields: [mapId], references: [id])
  turnTimeSeconds  Int?
  maxScore         Int?
  creatorGoesFirst Boolean?
  costCapOverride  Int?
  createdAt        DateTime          @default(now())

  childEdges  RoguelikeEdge[]       @relation("RoguelikeEdgeParent")
  parentEdges RoguelikeEdge[]       @relation("RoguelikeEdgeChild")
  defeats     RoguelikeNodeDefeat[]

  @@index([campaignId])
}

model RoguelikeEdge {
  id       Int           @id @default(autoincrement())
  parentId Int
  parent   RoguelikeNode @relation("RoguelikeEdgeParent", fields: [parentId], references: [id])
  childId  Int
  child    RoguelikeNode @relation("RoguelikeEdgeChild", fields: [childId], references: [id])
  twoWay   Boolean       @default(false)

  @@unique([parentId, childId])
  @@index([parentId])
}

model RoguelikeRun {
  id             Int                @id @default(autoincrement())
  userId         String
  user           User               @relation(fields: [userId], references: [id])
  generation     Int                @default(1)
  status         RoguelikeRunStatus @default(ACTIVE)
  campaignId     Int
  campaign       RoguelikeCampaign  @relation(fields: [campaignId], references: [id])
  currentNodeId  Int
  currentCostCap Int
  activeLobbyId  Int?
  createdAt      DateTime           @default(now())
  endedAt        DateTime?

  roster  RoguelikeRosterShip[]
  defeats RoguelikeNodeDefeat[]
  lobbies Lobby[]

  @@index([userId])
  @@index([userId, status])
}

enum RoguelikeRunStatus {
  ACTIVE
  WON
  ENDED
}

model RoguelikeRosterShip {
  id     Int          @id @default(autoincrement())
  runId  Int
  run    RoguelikeRun @relation(fields: [runId], references: [id])
  shipId Int
  ship   Ship         @relation(fields: [shipId], references: [id])
  // 0 = undamaged/full, NOT literally zero HP — matches the on-chain
  // getShipHP convention exactly (see useRoguelikeRosterHP's doc-comment).
  hp     Int          @default(0)

  @@unique([runId, shipId])
  @@index([runId])
}

// Gates re-entry via a twoWay back-edge into a Combat node already cleared
// earlier this run — matches RoguelikeRun.isNodeDefeated/setNodeDefeated.
model RoguelikeNodeDefeat {
  id     Int           @id @default(autoincrement())
  runId  Int
  run    RoguelikeRun  @relation(fields: [runId], references: [id])
  nodeId Int
  node   RoguelikeNode @relation(fields: [nodeId], references: [id])

  @@unique([runId, nodeId])
  @@index([runId])
}

// ── System Config ──────────────────────────────────────────────────────────────
// Key/value store for admin-managed settings (e.g. ship cost tables).

model Config {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ── Player Stats ───────────────────────────────────────────────────────────────

model PlayerStats {
  userId     String @id
  user       User   @relation(fields: [userId], references: [id])
  wins       Int    @default(0)
  losses     Int    @default(0)
  draws      Int    @default(0)
  totalGames Int    @default(0)

  @@index([wins])
}

// ── Tournaments ────────────────────────────────────────────────────────────────
// Web2 counterpart to the on-chain Tournament contract. Single-elimination
// bracket; sybil resistance is "one registration per Google account" (the
// @@unique on TournamentRegistrant) instead of a World ID proof; entry
// fee/prize pool use the existing in-app credit balance (User.creditBalance)
// instead of on-chain ETH escrow, paid out directly on finalize instead of
// via a pull-based claim step. Each match is played through a completely
// normal Lobby/Fleet/Game row (see TournamentMatch.lobbyId) — no separate
// game logic for tournament play.

model Tournament {
  id              Int             @id @default(autoincrement())
  creatorId       String
  creator         User            @relation("TournamentCreator", fields: [creatorId], references: [id])
  state           TournamentState @default(REGISTRATION)
  entryFee        Int             @default(0) // credits
  minPlayers      Int
  maxPlayers      Int // 2 / 4 / 8 / 16
  registerBy      DateTime // registration deadline
  costLimit       Int
  turnTimeSeconds Int
  selectedMapId   Int
  maxScore        Int
  prizePool       Int             @default(0) // entryFee * registrants + sponsor top-up
  totalRounds     Int? // set at start()
  championId      String?
  runnerUpId      String?
  createdAt       DateTime        @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  registrants TournamentRegistrant[]
  matches     TournamentMatch[]

  @@index([state])
}

enum TournamentState {
  REGISTRATION
  ACTIVE
  COMPLETE
  CANCELLED
}

model TournamentRegistrant {
  id           Int        @id @default(autoincrement())
  tournamentId Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  registeredAt DateTime   @default(now())

  @@unique([tournamentId, userId]) // one Google account = one registration
}

model TournamentMatch {
  id           Int        @id @default(autoincrement())
  tournamentId Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  round        Int // 0-indexed
  matchIndex   Int // position within round
  player1Id    String?
  player1      User?      @relation("TournamentMatchPlayer1", fields: [player1Id], references: [id])
  player2Id    String?
  player2      User?      @relation("TournamentMatchPlayer2", fields: [player2Id], references: [id])
  winnerId     String?
  isBye        Boolean    @default(false)
  resolved     Boolean    @default(false)
  lobbyId      Int?       @unique
  lobby        Lobby?     @relation(fields: [lobbyId], references: [id])
  createdAt    DateTime   @default(now())

  @@index([tournamentId, round])
}

// ── Node display content (campaign map editor) ──────────────────────────────
// Title/description for a campaign or roguelike node, keyed by (graphType,
// nodeId) — nodeId is a plain numeric id from whichever graph's own id space
// (NodeMap/CampaignNode ids for CAMPAIGN, RoguelikeNodeMap/RoguelikeNode ids
// for ROGUELIKE; web2 and web3 node ids are assumed aligned per graph, same
// assumption app/config/campaignNodes.ts already makes). This is a pure
// display-content overlay — never gameplay logic — so it's the same single
// table for both web2 and web3 node graphs. The hand-maintained
// campaignNodes.ts/roguelikeNodes.ts static files stay in place as a
// fallback layer: a row here wins if present, otherwise those files' content
// is used, otherwise a generic default (see useNodeContent.ts).
enum NodeGraphType {
  CAMPAIGN
  ROGUELIKE
}

// publishedTitle/publishedDescription/dirtyAt track the on-chain
// NodeContentRegistry publish flow layered on top of this table (see
// contracts/NodeContentRegistry.sol and app/api/node-content/publish/
// route.ts): title/description remain the live-editable draft (unchanged
// behavior — every PUT here is instant, no gas/wallet involved), while
// publishedTitle/publishedDescription are the last values this row is
// known to have on-chain, refreshed either by a successful publish or by
// /api/node-content/sync pulling the registry's current state. A row is
// "dirty" (has an unpublished edit) whenever dirtyAt is non-null; the
// publish endpoint's chunked batches are drawn from exactly those rows,
// and dirtyAt is cleared back to null once its chunk's tx confirms. Kept
// as an explicit timestamp column (not just a computed title !==
// publishedTitle check) so "N nodes pending" and "oldest unpublished edit"
// are cheap, indexed queries for the publish admin UI, not a table scan.
model NodeContent {
  id                   Int           @id @default(autoincrement())
  graphType            NodeGraphType
  nodeId               Int
  title                String
  description          String
  publishedTitle       String?
  publishedDescription String?
  dirtyAt              DateTime?
  updatedAt            DateTime      @updatedAt

  @@unique([graphType, nodeId])
  @@index([graphType])
  @@index([graphType, dirtyAt])
}
